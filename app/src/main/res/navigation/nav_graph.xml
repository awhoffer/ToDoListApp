<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/fragmentAllLists">
    <fragment
        android:id="@+id/fragmentAllLists"
        android:name="com.example.todolist.FragmentAllLists"
        android:label="fragment_all_lists"
        tools:layout="@layout/fragment_all_lists" >
        <action
            android:id="@+id/action_fragmentAllLists_to_fragmentViewList"
            app:destination="@id/fragmentViewList"
            app:popUpTo="@id/fragmentAllLists"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/fragmentViewList"
        android:name="com.example.todolist.FragmentViewList"
        android:label="fragment_view_list"
        tools:layout="@layout/fragment_view_list" >
        <action
            android:id="@+id/action_fragmentViewList_to_fragmentAllLists"
            app:destination="@id/fragmentAllLists"
            app:popUpTo="@id/fragmentViewList"
            app:popUpToInclusive="true" />
        <argument
            android:name="ListIdArg"
            app:argType="integer"
            android:defaultValue="-1" />
        <argument
            android:name="ListTitle"
            app:argType="string" />
    </fragment>
</navigation>